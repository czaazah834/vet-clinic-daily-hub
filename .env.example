# Neon PostgreSQL Connection String
# Get this from your Neon Console (https://console.neon.tech/)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[database]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sweet-pond-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Application Port
PORT=3000

# Security Session Secret
SESSION_SECRET=pawcare_production_secure_secret_key_9921_long

# SMS Gateway (Optional - leave empty for Dev Inbox simulator)
PHILSMS_TOKEN=

# Email SMTP (Optional - leave empty for Dev Inbox simulator)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PawCare Clinic <noreply@pawcare.com>"

